---
import { Image } from "astro:assets";
import { tripMonths, tripWhere, type Trip } from "../lib/data";
interface Props { trip: Trip; tilt?: number }
const { trip, tilt = 0 } = Astro.props;
const d = trip.data;
---
<a class="postcard" href={`/trips/${trip.id}/`} style={`--tilt:${tilt}deg`}>
  <Image src={d.cover} alt={d.coverAlt} widths={[400, 680]} sizes="(max-width: 600px) 78vw, 320px" />
  <div class="caption">
    <h4>{d.title}</h4>
    <p class="when">{tripMonths(d.start, d.end)}, {tripWhere(trip)}</p>
    <p class="summary">{d.summary}</p>
  </div>
</a>
