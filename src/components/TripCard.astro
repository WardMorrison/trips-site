---
import { Image } from "astro:assets";
import type { Trip } from "../lib/data";
interface Props { trip: Trip; eager?: boolean }
const { trip, eager = false } = Astro.props;
const d = trip.data;
---
<a class="trip-card" href={`/trips/${trip.id}/`}>
  <Image src={d.cover} alt={d.coverAlt} widths={[360, 640]} sizes="(max-width: 600px) 70vw, 300px" loading={eager ? "eager" : "lazy"} />
  <span class="t">{d.title}</span>
  <span class="y">{d.start.getUTCFullYear()}</span>
</a>
