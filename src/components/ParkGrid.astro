---
// One square per unit of the National Park System, visited ones filled.
import { site } from "../lib/data";
interface Props { visited: number }
const { visited } = Astro.props;
const squares = Array.from({ length: site.npsTotal }, (_, i) => i < visited);
---
<div class="park-grid" role="img" aria-label={`${visited} of ${site.npsTotal} national park sites visited`}>
  {squares.map((v) => <i class={v ? "v" : undefined}></i>)}
</div>
