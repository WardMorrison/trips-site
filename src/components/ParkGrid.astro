---
// One dot per unit of the National Park System, filled as they're collected.
import { site } from "../lib/data";
interface Props { visited: number }
const { visited } = Astro.props;
const dots = Array.from({ length: site.npsTotal }, (_, i) => i < visited);
---
<div class="park-dots" role="img" aria-label={`${visited} of ${site.npsTotal} national park sites visited`}>
  {dots.map((v) => <i class={v ? "v" : undefined}></i>)}
</div>
