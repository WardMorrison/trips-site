---
import { site, FIFTY } from "../lib/data";
interface Props { continents: number; countries: number; states: number; parks: number }
const { continents, countries, states, parks } = Astro.props;
const pct = (a: number, b: number) => `${Math.min(100, (a / b) * 100).toFixed(1)}%`;
---
<div class="stats">
  <div class="stat">
    <div class="n">{continents}<small> / 7</small></div>
    <div class="label">Continents</div>
    <div class="bar"><span style={`width:${pct(continents, 7)}`}></span></div>
  </div>
  <div class="stat">
    <div class="n">{countries}</div>
    <div class="label">{countries === 1 ? "Country" : "Countries"}</div>
  </div>
  <div class="stat">
    <div class="n">{states}<small> / {FIFTY.length}</small></div>
    <div class="label">U.S. states</div>
    <div class="bar"><span style={`width:${pct(states, FIFTY.length)}`}></span></div>
  </div>
  <div class="stat">
    <div class="n">{parks}<small> / {site.npsTotal}</small></div>
    <div class="label">National park sites</div>
    <div class="bar"><span style={`width:${pct(parks, site.npsTotal)}`}></span></div>
  </div>
</div>
