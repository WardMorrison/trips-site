---
// World and U.S. maps, drawn at build time. A two-tab switch picks which one shows.
import { worldMap, usMap } from "../lib/maps";
import { site, parks, STATE_NAMES } from "../lib/data";
interface Props { countryIsos: Set<string>; states: Set<string>; parkCodes: Set<string>; showParks?: boolean; initial?: "world" | "us" }
const { countryIsos, states, parkCodes, showParks = true, initial = "world" } = Astro.props;
const w = worldMap(countryIsos);
const us = usMap(states);
const homes = site.homeBases;
const parkPts = parks
  .map((p) => ({ p, xy: us.project(p), v: parkCodes.has(p.code) }))
  .filter((x) => x.xy)
  .sort((a, b) => Number(a.v) - Number(b.v)); // visited drawn on top
---
<div class="atlas" data-atlas>
  <div class="tabs" role="tablist" aria-label="Map">
    <button role="tab" id="tab-world" aria-controls="panel-world" aria-selected={String(initial === "world")}>World</button>
    <button role="tab" id="tab-us" aria-controls="panel-us" aria-selected={String(initial === "us")}>United States</button>
  </div>

  <div class="atlas-panel" id="panel-world" role="tabpanel" aria-labelledby="tab-world" hidden={initial !== "world"}>
    <div class="atlas-frame">
      <svg class="map" viewBox={`0 0 ${w.width} ${w.height}`} role="img" aria-label="World map with visited countries shaded">
        <path class="sphere" d={w.sphere} />
        <path class="graticule" d={w.graticule} />
        {w.lands.map((l) => <path class={l.visited ? "land visited" : "land"} d={l.d}><title>{l.name}{l.visited ? " (visited)" : ""}</title></path>)}
        <path class="borders" d={w.borders} />
        {w.extraDots.map((d) => <circle class="dot" cx={d.x} cy={d.y} r="3.5"><title>{d.name} (visited)</title></circle>)}
        {homes.map((h) => { const xy = w.project(h)!; return <circle class="home" cx={xy.x} cy={xy.y} r="4.5"><title>{h.name} ({h.note})</title></circle>; })}
      </svg>
    </div>
    <div class="legend">
      <span><i class="key visited"></i>Visited</span>
      <span><i class="key notyet"></i>Not yet</span>
      <span><i class="key home"></i>Home bases</span>
    </div>
  </div>

  <div class="atlas-panel" id="panel-us" role="tabpanel" aria-labelledby="tab-us" hidden={initial !== "us"}>
    <div class="atlas-frame">
      <svg class="map" viewBox={`0 0 ${us.width} ${us.height}`} role="img" aria-label="United States map with visited states shaded and national park sites marked">
        {us.states.map((s) => <path class={s.visited ? "state visited" : "state"} d={s.d}><title>{s.name}{s.visited ? " (visited)" : ""}</title></path>)}
        {showParks && parkPts.map(({ p, xy, v }) => (
          <circle class={v ? "park visited" : "park"} cx={xy!.x} cy={xy!.y} r={v ? 4.2 : 2.6}><title>{p.name}{v ? " (visited)" : ""}</title></circle>
        ))}
        {homes.map((h) => {
          const xy = us.project(h);
          return xy && (
            <g>
              <circle class="home" cx={xy.x} cy={xy.y} r="6"><title>{h.name} ({h.note})</title></circle>
              <text class="home-label" x={xy.x + (xy.x > us.width * 0.8 ? -10 : 10)} y={xy.y + 4} text-anchor={xy.x > us.width * 0.8 ? "end" : "start"}>{h.name}</text>
            </g>
          );
        })}
      </svg>
    </div>
    <div class="legend">
      <span><i class="key visited"></i>Visited state</span>
      {showParks && <span><i class="key park-v"></i>Park site visited</span>}
      {showParks && <span><i class="key park-n"></i>Not yet</span>}
      <span><i class="key home"></i>Home bases</span>
    </div>
  </div>
</div>

<script>
  for (const atlas of document.querySelectorAll<HTMLElement>("[data-atlas]")) {
    const tabs = [...atlas.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const show = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        atlas.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => show(t));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
          next.focus(); show(next);
        }
      });
    });
  }
</script>
