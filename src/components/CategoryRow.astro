---
import TripCard from "./TripCard.astro";
import TrailSign from "./TrailSign.astro";
import type { Trip } from "../lib/data";
interface Props { id: string; label: string; trips: Trip[] }
const { id, label, trips } = Astro.props;
---
<div class="row" data-row>
  <div class="row-head">
    <TrailSign id={`row-${id}`}>{label}</TrailSign>
    <span class="count">{trips.length === 1 ? "1 trip" : `${trips.length} trips`}</span>
    {trips.length > 1 && (
      <div class="arrows">
        <button class="prev" type="button" aria-label={`Scroll ${label} back`} disabled></button>
        <button class="next" type="button" aria-label={`Scroll ${label} forward`}></button>
      </div>
    )}
  </div>
  {trips.length ? (
    <div class="track" role="list" aria-labelledby={`row-${id}`} tabindex="0">
      {trips.map((t, i) => <div role="listitem" style="display:contents"><TripCard trip={t} tilt={[-1.4, 1.1, -0.6, 1.6][i % 4]} /></div>)}
    </div>
  ) : (
    <p class="empty-row">No {label.toLowerCase()} trips posted yet.</p>
  )}
</div>

<script>
  for (const row of document.querySelectorAll<HTMLElement>("[data-row]")) {
    const track = row.querySelector<HTMLElement>(".track");
    const prev = row.querySelector<HTMLButtonElement>(".prev");
    const next = row.querySelector<HTMLButtonElement>(".next");
    if (!track || !prev || !next) continue;
    const step = () => track.clientWidth * 0.85;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: reduce ? "auto" : "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: reduce ? "auto" : "smooth" }));
    const update = () => {
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    track.addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>
