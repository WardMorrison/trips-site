---
import Base from "../layouts/Base.astro";
import USMap from "../components/USMap.astro";
import WorldMap from "../components/WorldMap.astro";
import TripRow from "../components/TripRow.astro";
import { getVisited, site, FIFTY } from "../lib/data";

const v = await getVisited();
const hasSamples = v.trips.some((t) => t.data.sample);
---
<Base sample={hasSamples}>
  <main>
    <section class="wrap map-block" aria-labelledby="us-h">
      <h2 id="us-h">United States</h2>
      <USMap states={v.states} parkCodes={v.parkCodes} />
      <p class="caption">
        <span>{v.fiftyVisited.length} of {FIFTY.length} states, <a href="/parks/">{v.parkCodes.size} of {site.npsTotal} park sites</a></span>
        <span class="key"><i class="k-state"></i>visited <i class="k-park"></i>park site <i class="k-home"></i>home</span>
      </p>
    </section>

    <section class="wrap map-block" aria-labelledby="world-h">
      <h2 id="world-h">World</h2>
      <WorldMap countryIsos={v.countryIsos} />
      <p class="caption">{v.countryIsos.size} countries</p>
    </section>

    <TripRow trips={v.trips} />
  </main>
</Base>
