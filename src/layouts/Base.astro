---
import "../styles/global.css";
import { site } from "../lib/data";

interface Props { title?: string; description?: string; image?: string; sample?: boolean }
const { title, description = site.description, image, sample = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}, ${site.author}` : `${site.title}, ${site.author}`;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const nav = [
  { href: "/", label: "Trips", active: path === "/" || path.startsWith("/trips") },
  { href: "/parks/", label: "Parks", active: path.startsWith("/parks") },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#f2ebdb" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={new URL(image, canonical).href} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap" />
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <!-- Rough, uneven ink for the passport stamps. -->
      <filter id="ink" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.2" result="rough" />
        <feComponentTransfer in="noise" result="speckle"><feFuncA type="discrete" tableValues="1 1 1 0.35 1 1 0.6 1" /></feComponentTransfer>
        <feComposite in="rough" in2="speckle" operator="in" />
      </filter>
    </defs>
  </svg>
  <header class="site-head wrap">
    <a class="sign-logo" href="/">Trips</a>
    <nav aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={n.active ? "page" : undefined}>{n.label}</a>)}
      <a href="https://photos.wardmorrison.com">Photos</a>
    </nav>
  </header>
  {sample && (
    <p class="sample-note wrap">Sample trips are placeholders and don't count toward the totals. Delete the sample-* folders in src/content/trips once real trips are in.</p>
  )}
  <slot />
  <footer class="site-foot wrap">
    <p>{site.author}. {site.links.map((l, i) => <>{i > 0 && ", "}<a href={l.url}>{l.label}</a></>)}, <a href="mailto:ward.l.morrison@gmail.com">email</a>.</p>
    <p class="credit">Park list from the National Park Service; map outlines from Natural Earth and the U.S. Census Bureau. Not affiliated with the National Park Service.</p>
  </footer>
</body>
</html>
