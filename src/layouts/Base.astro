---
import "../styles/global.css";
import { site } from "../lib/data";

interface Props { title?: string; description?: string; image?: string; sample?: boolean }
const { title, description = site.description, image, sample = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}, ${site.author}` : `${site.title}, ${site.author}`;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const nav = [
  { href: "/", label: "Trips", active: path === "/" || path.startsWith("/trips") },
  { href: "/parks/", label: "Parks", active: path.startsWith("/parks") },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#121212" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={new URL(image, canonical).href} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap" />
</head>
<body>
  <header class="band site-head">
    <div class="wrap">
      <a class="site-title" href="/">Trips</a>
      <span class="byline">{site.author}</span>
      <nav aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={n.active ? "page" : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  {sample && (
    <div class="sample-note"><div class="wrap">Sample content. Delete the sample-* folders in src/content/trips once real trips are in.</div></div>
  )}
  <slot />
  <footer class="band site-foot">
    <div class="wrap">
      {site.links.map((l) => <a href={l.url}>{l.label}</a>)}
      <a href="mailto:ward.l.morrison@gmail.com">Email</a>
      <span class="credit">Park list: National Park Service. Map outlines: Natural Earth and the U.S. Census Bureau. Not affiliated with the National Park Service.</span>
    </div>
  </footer>
</body>
</html>
