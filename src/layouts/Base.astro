---
import "../styles/global.css";
import { site } from "../lib/data";

interface Props { title?: string; description?: string; image?: string; sample?: boolean }
const { title, description = site.description, image, sample = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}, ${site.author}` : `${site.title}, ${site.author}`;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#E9E4D9" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={new URL(image, canonical).href} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
</head>
<body>
  <header class="site-head wrap">
    <a class="name" href="/">Ward Morrison</a>
    <nav aria-label="Main">
      <a href="/" aria-current={path === "/" ? "page" : undefined}>Trips</a>
      <a href="/parks/" aria-current={path.startsWith("/parks") ? "page" : undefined}>Parks</a>
      <a href="https://photos.wardmorrison.com">Photos</a>
    </nav>
  </header>
  {sample && <p class="sample-note wrap">Test trips shown. They don't count toward the totals.</p>}
  <slot />
  <footer class="site-foot wrap">
    <a href="mailto:ward.l.morrison@gmail.com">ward.l.morrison@gmail.com</a>
    <a href="https://instagram.com/morrison_photo">@morrison_photo</a>
  </footer>
</body>
</html>
